---
// Figma: dark "Zoom controls" + "Recentre" on the signed-in Discover screens.
interface Props { recentreHref?: string }
const { recentreHref } = Astro.props;
const Tag = recentreHref ? 'a' : 'button';
---
<Tag href={recentreHref} type={recentreHref ? undefined : 'button'} class="absolute left-[1197px] top-[767px] block h-[37px] w-[100px] rounded-[999px] border border-[#3c3c43] bg-[#2c2c31]">
  <span class="absolute left-[13px] top-[12px] size-[11px] rounded-full bg-brand"></span>
  <span class="absolute left-[32px] top-[9px] whitespace-nowrap text-[12px] leading-[1.4] font-semibold text-[#e7e5ea]">Recentre</span>
</Tag>
<div class="absolute left-[1358px] top-[716px] h-[88px] w-[42px] rounded-[14px] border border-[#3c3c43] bg-[#2c2c31] shadow-[0px_2px_10px_0px_rgba(0,0,0,0.3)]">
  <button type="button" aria-label="Zoom in" class="absolute left-[14px] top-[9px] text-[17px] leading-[1.4] font-bold text-[#e7e5ea]">+</button>
  <button type="button" aria-label="Zoom out" class="absolute left-[15.5px] top-[53px] text-[17px] leading-[1.4] font-bold text-[#e7e5ea]">–</button>
</div>
