---
// Figma: "Auth card" (486 wide) — 📸 3 empty state, 📸 4 filled in by Kit Tan.
import { ROUTES } from '../../data/routes';

interface Props { filled?: boolean }
const { filled = false } = Astro.props;
const h = filled ? 644 : 660;
const footerTop = filled ? 604 : 620;
const showCls = filled ? 'text-[#1a1a1a]' : 'text-[#bbb]';
const eye = filled ? '/assets/icons/eye-dark.svg' : '/assets/icons/eye-muted.svg';
const valueCls = filled ? 'text-black' : 'text-[#9a9a9a]';
---
<div class="absolute left-[574px] top-[164px] w-[486px]" style={`height:${h}px`} role="dialog" aria-modal="true" aria-labelledby="signup-title">
  <div class="absolute left-0 top-0 w-[486px] rounded-[30px] bg-[#fafafa]" style={`height:${h}px`}></div>
  <img src="/assets/img/brand.png" alt="LittleRedMusic" width="40" height="40" class="absolute left-[220px] top-[24px] size-[40px] object-contain" />
  <h1 id="signup-title" class="absolute left-[189px] top-[64px] m-0 whitespace-nowrap text-[30px] leading-normal font-semibold text-black">Sign up</h1>
  <p class="absolute left-[159px] top-[113px] m-0 whitespace-nowrap text-[12px] leading-normal font-semibold text-[#3c3d3d]">Save your music preferences</p>

  <p class="absolute left-[88px] top-[130px] m-0 whitespace-nowrap text-[14px] leading-normal font-medium text-[#1a1a1a]">Email:</p>
  {filled
    ? <div class="absolute left-[88px] top-[151px] h-[48px] w-[310px] overflow-clip rounded-[8px] border border-[#ddd] bg-white">
        <p class={`absolute left-[15px] top-[15px] m-0 whitespace-nowrap text-[14px] leading-normal ${valueCls}`}>kittan21@gmail.com</p>
      </div>
    : <a href={ROUTES.signupFilled} class="absolute left-[88px] top-[151px] block h-[48px] w-[310px] overflow-clip rounded-[8px] border border-[#ddd] bg-white">
        <p class={`absolute left-[15px] top-[15px] m-0 whitespace-nowrap text-[14px] leading-normal ${valueCls}`}>Email address</p>
      </a>}

  <p class="absolute left-[88px] top-[205px] m-0 whitespace-nowrap text-[14px] leading-normal font-medium text-[#1a1a1a]">Password:</p>
  <div class="absolute left-[88px] top-[226px] h-[48px] w-[310px] overflow-clip rounded-[8px] border border-[#ddd] bg-white">
    <p class={`absolute left-[15px] top-[15px] m-0 whitespace-nowrap text-[14px] leading-normal ${valueCls}`}>{filled ? '•••••••••••' : 'Create a password'}</p>
    <img src={eye} alt="" width="16" height="9" class="absolute left-[234px] top-[17.5px] max-w-none" />
    <p class={`absolute left-[257px] top-[15px] m-0 whitespace-nowrap text-[13px] leading-normal font-semibold ${showCls}`}>Show</p>
  </div>

  <p class="absolute left-[89px] top-[275px] m-0 whitespace-nowrap text-[14px] leading-normal font-medium text-[#1a1a1a]">Confirm password:</p>
  <div class="absolute left-[88px] top-[299px] h-[48px] w-[310px] overflow-clip rounded-[8px] border border-[#ddd] bg-white">
    <p class={`absolute left-[15px] top-[15px] m-0 whitespace-nowrap text-[14px] leading-normal ${valueCls}`}>{filled ? '•••••••••••' : 'Confirm password'}</p>
    <img src={eye} alt="" width="16" height="9" class="absolute left-[234px] top-[17.5px] max-w-none" />
    <p class={`absolute left-[257px] top-[15px] m-0 whitespace-nowrap text-[13px] leading-normal font-semibold ${showCls}`}>Show</p>
  </div>

  <!-- or sign up with -->
  <div class="absolute left-[88px] top-[364px] h-[16px] w-[310px]">
    <p class="absolute left-[113px] top-0 m-0 whitespace-nowrap text-[12px] leading-normal text-[#8a8a8a]">or sign up with</p>
    <div class="absolute left-0 top-[8px] h-px w-[97px] bg-[#d9d9d9]"></div>
    <div class="absolute left-[213px] top-[8px] h-px w-[97px] bg-[#d9d9d9]"></div>
  </div>
  <button type="button" class="absolute left-[115px] top-[392px] block h-[35px] w-[256px] rounded-[17.5px] border border-[#111]">
    <span class="absolute left-[59px] top-[11px] size-[13px] rounded-[3px] border border-dashed border-black"></span>
    <span class="absolute left-[76px] top-[8px] whitespace-nowrap text-[13px] leading-normal font-medium text-black">Sign up with Google</span>
  </button>
  <button type="button" class="absolute left-[115px] top-[437px] block h-[35px] w-[256px] rounded-[17.5px] bg-[#111]">
    <span class="absolute left-[59px] top-[11px] size-[13px] rounded-[3px] border border-dashed border-white"></span>
    <span class="absolute left-[81px] top-[10px] whitespace-nowrap text-[13px] leading-normal font-medium text-white">Sign up with Apple</span>
  </button>

  {filled
    ? <img src="/assets/icons/checkbox-dark.svg" alt="" width="16" height="16" class="absolute left-[99px] top-[499px] size-[16px]" />
    : <span class="absolute left-[99px] top-[499px] size-[16px] rounded-[3px] border border-black"></span>}
  <p class="absolute left-[123px] top-[499px] m-0 whitespace-nowrap text-[13px] leading-normal text-[#3c3d3d]">I agree to the Terms and Privacy Policy</p>

  {filled
    ? <a href={ROUTES.onboarding} class="absolute left-[89px] top-[528px] block h-[52px] w-[310px] overflow-clip rounded-[26px] bg-[#1a1a1a]">
        <span class="absolute left-[99px] top-[17px] whitespace-nowrap text-[15px] leading-normal font-semibold text-white">Create account</span>
      </a>
    : <>
        <button type="button" disabled class="absolute left-[89px] top-[528px] block h-[52px] w-[310px] cursor-not-allowed overflow-clip rounded-[26px] bg-[#d9d9d9]">
          <span class="absolute left-[99px] top-[17px] whitespace-nowrap text-[15px] leading-normal font-semibold text-[#8a8a8a]">Create account</span>
        </button>
        <p class="absolute left-[244px] top-[590px] m-0 w-[310px] -translate-x-1/2 text-center text-[12px] leading-normal text-[#8a8a8a]">Fill in every field and accept the terms to continue.</p>
      </>}

  <p class="absolute left-[142px] m-0 whitespace-nowrap text-[13px] leading-normal text-[#3c3d3d]" style={`top:${footerTop}px`}>Already have an account?</p>
  <button type="button" class="absolute left-[306px] whitespace-nowrap text-[13px] leading-normal font-semibold text-black" style={`top:${footerTop}px`}>Log in</button>

  <a href={ROUTES.discover} aria-label="Close sign up" class="absolute left-[434px] top-[16px] block size-[32px] rounded-[12px]">
    <span class="absolute left-[8px] top-[0.5px] whitespace-nowrap text-[24px] leading-normal text-[#666]">×</span>
  </a>
</div>
