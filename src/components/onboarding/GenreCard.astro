---
// Figma: "card / Pick your genres" (520 × 340).
//   chipStyle "dark" → selected chips are black (📸 6)
//   chipStyle "bold" → selected chips stay white with bold text (manual taste profile)
import { GENRE_BY_KEY, type GenreKey } from '../../data/genres';

interface Props {
  x: number; y: number;
  title: string;
  selected: string[];
  chipStyle: 'dark' | 'bold';
  summary: string;
  dotOverrides?: Record<string, string>;
}
const { x, y, title, selected, chipStyle, summary, dotOverrides = {} } = Astro.props;

const MAIN: { key: GenreKey; x: number; y: number }[] = [
  { key: 'indie', x: 23, y: 75 },  { key: 'pop', x: 263, y: 75 },
  { key: 'mandopop', x: 23, y: 113 }, { key: 'electronic', x: 263, y: 113 },
  { key: 'hiphop', x: 23, y: 151 }, { key: 'ethnic', x: 263, y: 151 },
];
const SUB: { name: string; genre: GenreKey; x: number; y: number; w: number }[] = [
  { name: 'House', genre: 'electronic', x: 23, y: 221, w: 73 },
  { name: 'Techno', genre: 'electronic', x: 104, y: 221, w: 78 },
  { name: 'Synthwave', genre: 'electronic', x: 190, y: 221, w: 101 },
  { name: 'Drum & Bass', genre: 'electronic', x: 299, y: 221, w: 109 },
  { name: 'Alt-Pop', genre: 'pop', x: 416, y: 221, w: 79 },
  { name: 'Lo-fi Hip-Hop', genre: 'hiphop', x: 23, y: 253, w: 114 },
  { name: 'Post-Rock', genre: 'indie', x: 145, y: 253, w: 95 },
  { name: 'Gamelan', genre: 'ethnic', x: 248, y: 253, w: 86 },
  { name: 'Mandopop Ballads', genre: 'mandopop', x: 342, y: 253, w: 141 },
];
const dot = (name: string, g: GenreKey) => dotOverrides[name] ?? GENRE_BY_KEY[g].dot;
---
<div class="absolute h-[340px] w-[520px] overflow-clip rounded-[12px] border border-[#ddd] bg-white" style={`left:${x}px; top:${y}px`}>
  <p class="absolute left-[23px] top-[23px] m-0 whitespace-nowrap text-[16px] leading-normal font-semibold text-[#1a1a1a]">{title}</p>
  <p class="absolute left-[23px] top-[47px] m-0 whitespace-nowrap text-[12px] leading-normal text-[#888]">These are the clusters on your Discover map.</p>

  {MAIN.map((c) => {
    const g = GENRE_BY_KEY[c.key];
    const on = selected.includes(g.name);
    const dark = on && chipStyle === 'dark';
    return (
      <button type="button" aria-pressed={on ? 'true' : 'false'} class={`absolute block h-[34px] w-[232px] rounded-[17px] text-left ${dark ? 'bg-[#1a1a1a]' : 'border border-[#ddd] bg-white'}`} style={`left:${c.x}px; top:${c.y}px`}>
        <span class={`absolute size-[8px] rounded-full ${dark ? 'left-[14px] top-[13px]' : 'left-[13px] top-[12px]'}`} style={`background:${dot(g.name, c.key)}`}></span>
        <span class={`absolute whitespace-nowrap text-[12px] leading-normal ${dark ? 'left-[30px] top-[10px] font-semibold text-white' : `left-[29px] top-[9px] text-[#1a1a1a] ${on ? 'font-semibold' : ''}`}`}>{g.name}</span>
      </button>
    );
  })}

  <p class="absolute left-[23px] top-[197px] m-0 whitespace-nowrap text-[12px] leading-normal font-semibold text-[#888]">Narrow it down — optional</p>
  {SUB.map((c) => {
    const on = selected.includes(c.name);
    const dark = on && chipStyle === 'dark';
    return (
      <button type="button" aria-pressed={on ? 'true' : 'false'} class={`absolute block h-[26px] rounded-[13px] text-left ${dark ? 'bg-[#1a1a1a]' : 'border border-[#ddd] bg-white'}`} style={`left:${c.x}px; top:${c.y}px; width:${c.w}px`}>
        <span class={`absolute size-[6px] rounded-full ${dark ? 'left-[12px] top-[10px]' : 'left-[11px] top-[9px]'}`} style={`background:${dot(c.name, c.genre)}`}></span>
        <span class={`absolute whitespace-nowrap text-[12px] leading-normal ${dark ? 'left-[24px] top-[6px] font-semibold text-white' : `left-[23px] top-[5px] text-[#1a1a1a] ${on ? 'font-semibold' : ''}`}`}>{c.name}</span>
      </button>
    );
  })}

  <p class="absolute left-[23px] top-[299px] m-0 whitespace-nowrap text-[12px] leading-normal text-[#666]">{summary}</p>
</div>
