---
// 📸 10 / 📸 11 Artist page (FallingIslands) — hero + About + Social + tabs.
import NavBar from '../NavBar.astro';
import { ROUTES } from '../../data/routes';
import { IMG } from '../../data/images';

interface Props { tab: 'portfolio' | 'events' }
const { tab } = Astro.props;
const glassBtn = 'absolute top-[216px] block h-[48px] rounded-[10px] border border-white/45 bg-white/18 shadow-[0px_2px_14px_0px_rgba(0,0,0,0.3)] backdrop-blur-[8px] font-geist text-[14px] leading-normal font-semibold text-white';
const TABS = tab === 'portfolio'
  ? [{ x: 80, w: 67, t: 'Portfolio', on: true, href: ROUTES.artist }, { x: 171, w: 124, t: 'Upcoming Event', href: ROUTES.artistEvents, color: '#545454' }, { x: 319, w: 87, t: 'Past Events' }]
  : [{ x: 80, w: 64, t: 'Portfolio', href: ROUTES.artist }, { x: 168, w: 128, t: 'Upcoming Event', on: true, href: ROUTES.artistEvents }, { x: 320, w: 87, t: 'Past Events' }];
const CARDS = [
  { x: 80, title: 'Tracks of the Woods', by: 'FallingIslands' },
  { x: 513.3, title: 'City Busk Nights (Live)', by: 'FallingIslands · Kim Tan' },
  { x: 946.7, title: 'Echo Ambient Session #3', by: 'FallingIslands' },
];
---
<NavBar active="artists" />

<!-- hero -->
<div class="absolute left-0 top-[72px] h-[240px] w-[1440px] overflow-hidden" class:list={[tab === 'events' && 'rounded-[4px]']}>
  <img src={IMG.artistHero} alt="" class="size-full object-cover" />
</div>
<a href={ROUTES.artistWidget} class="absolute left-[48px] top-[96px] flex items-center gap-[8px] font-geist text-[14px] leading-normal font-semibold text-white">
  <img src="/assets/icons/arrow-left-white.svg" alt="" width="16" height="16" />Back to Artists
</a>
<span class="absolute left-[48px] top-[160px] block h-[28px] w-[125px] rounded-[6px] bg-[#747480]/8">
  <span class="absolute left-[12px] top-[6px] whitespace-nowrap font-geist text-[12px] leading-normal font-bold text-white">LIVE SYNTH SETS</span>
</span>
<span class={`absolute left-[181px] top-[160px] block h-[28px] w-[136px] rounded-[6px] ${tab === 'events' ? 'bg-[#1e1e22]' : 'bg-black'}`}>
  <span class="absolute left-[12px] top-[6px] whitespace-nowrap font-geist text-[12px] leading-normal font-bold text-white">SYNTHWAVE / EDM</span>
</span>
<h1 class="absolute left-[48px] top-[204px] m-0 whitespace-nowrap font-outfit text-[48px] leading-normal font-extrabold text-white">FallingIslands</h1>
<button type="button" class={`${glassBtn} left-[950px] w-[161px]`}>
  <img src="/assets/icons/heart-white.svg" alt="" width="16" height="16" class="absolute left-[30px] top-[15px]" />
  <span class="absolute left-[54px] top-[14px]">Save Artist</span>
</button>
<button type="button" class={`${glassBtn} left-[1123px] w-[111px]`}>
  <img src="/assets/icons/share-white.svg" alt="" width="16" height="16" class="absolute left-[23px] top-[15px]" />
  <span class="absolute left-[47px] top-[14px] whitespace-pre">Share </span>
</button>
<a href={ROUTES.thread} class={`${glassBtn} left-[1246px] w-[146px]`}>
  <span class="absolute left-[23px] top-[14px] whitespace-nowrap">Forum threads</span>
</a>

<!-- about -->
<h2 class="absolute left-[80px] top-[352px] m-0 font-dm text-[16px] leading-normal font-bold text-[#111827]">About Artist</h2>
<p class="absolute left-[80px] top-[385px] m-0 w-[1280px] font-dm text-[14px] leading-[1.5] text-[#4b5563]">FallingIslands builds neon synthwave out of analogue arpeggios and late-night field recordings. A regular on Singapore’s underground electronic circuit, they play warehouse rooms, listening bars and the occasional bunker.</p>
<h2 class="absolute left-[80px] top-[439px] m-0 font-outfit text-[16px] leading-normal font-bold text-black">Social Media</h2>
{['instagram', 'twitter', 'spotify', 'youtube'].map((s, i) => (
  <a href="#" aria-label={s} class="absolute top-[475px] block size-[44px]" style={`left:${80 + i * 56}px`}><img src={`/assets/icons/social-${s}.svg`} alt="" width="44" height="44" /></a>
))}

<!-- tabs -->
{TABS.map((t) => {
  const cls = `absolute top-[551px] block h-[41px] font-dm text-[16px] leading-normal ${t.on ? 'border-b border-[#111827] font-bold text-[#111827]' : 'font-medium'}`;
  const style = `left:${t.x}px; width:${t.w}px; ${t.on ? '' : `color:${t.color ?? '#4b5563'}`}`;
  return t.href
    ? <a href={t.href} class={cls} style={style}><span class="absolute left-0 top-[10px] whitespace-nowrap">{t.t}</span></a>
    : <span class={cls} style={style}><span class="absolute left-0 top-[10px] whitespace-nowrap">{t.t}</span></span>;
})}

{tab === 'portfolio' ? CARDS.map((c) => (
  <article class="absolute top-[624px] h-[197px] w-[413px] overflow-hidden rounded-[10px] border border-[#e5e7eb] bg-white" style={`left:${c.x}px`}>
    <div class="absolute left-[-1px] top-[-1px] h-[120px] w-[413px] border border-[#e5e7eb]">
      <img src={IMG.fallingArt} alt="" class="size-full object-cover" />
      <img src="/assets/icons/image-grey.svg" alt="" width="24" height="24" class="absolute left-[194.7px] top-[37px]" />
      <span class="absolute left-[147.2px] top-[69px] whitespace-nowrap font-geist-mono text-[11px] leading-normal text-[#9ca3af]">Track Visual Cover</span>
    </div>
    <p class="absolute left-[15px] top-[135px] m-0 w-[381px] font-dm text-[15px] leading-normal font-semibold text-[#111827]">{c.title}</p>
    <p class="absolute left-[15px] top-[163px] m-0 whitespace-nowrap font-dm text-[13px] leading-normal text-[#4b5563]">{c.by}</p>
  </article>
)) : (
  <>
    <div class="absolute left-[80px] top-[604px] h-px w-[1280px] bg-[#e5e7eb]"></div>
    <a href={ROUTES.eventsList} class="absolute left-[80px] top-[616px] text-[16px] leading-[1.4] text-[#0088ff] underline">See all upcoming events</a>
    <a href={ROUTES.event} class="absolute left-[80px] top-[670px] block h-[195px] w-[1280px] overflow-hidden rounded-[10px] border border-[#e5e7eb] bg-white">
      <div class="absolute left-[-1px] top-[-1px] h-[120px] w-[1280px] border border-[#e5e7eb]">
        <img src={IMG.artistUpcoming} alt="" class="size-full object-cover" />
      </div>
      <p class="absolute left-[15px] top-[135px] m-0 w-[1248px] text-[15px] leading-normal font-semibold text-[#111827]">FallingIslands at Bras Basah</p>
      <p class="absolute left-[15px] top-[161px] m-0 whitespace-nowrap font-dm text-[13px] leading-normal text-[#545454]">Wed 16 Sep · 8:00 PM</p>
    </a>
  </>
)}
