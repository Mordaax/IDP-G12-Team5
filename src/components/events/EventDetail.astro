---
// 📸 13 Events (Details) and 📸 14 Events (Details — Forum): BattleBox Fort Canning.
import NavBar from '../NavBar.astro';
import { ROUTES } from '../../data/routes';
import { IMG } from '../../data/images';
interface Props { tab: 'details' | 'forum' }
const { tab } = Astro.props;
const label = 'absolute m-0 whitespace-nowrap text-[11px] leading-normal font-medium tracking-[0.66px] text-[#747480]';
const val = 'absolute m-0 w-[368px] font-dm text-[14px] leading-[1.45]';
const SPECS: [number, number, string, string, string][] = [
  [80, 633, 'DATE & TIME', 'Sat 19 Sep 2026 · 8:00 PM', '#181818'],
  [80, 689, 'DOORS', '7:30 PM · First set 8:00 PM', '#111827'],
  [80, 745, 'VENUE', '2 Cox Terrace, Battlebox, Singapore 179622 · 0.4 km', '#181818'],
  [472, 633, 'SET TIMES', 'FallingIslands 8:00PM', '#181818'],
  [472, 689, 'ENTRY', '18+ with photo ID · Standing room', '#111827'],
  [472, 745, 'GETTING THERE', 'Fort Canning MRT (DT20)  — 4 min walk', '#181818'],
];
const COMMENTS: [number, number, string, string, number, string, string, string, number][] = [
  [80, 627, IMG.rosaPark, 'Rosa Park', 187, '· 2h', 'Anyone coming from east side? Happy to split a ride after the last set.', '♥ 6 · Reply', 545],
  [80, 697, IMG.joelTan, 'Joel Tan', 177, '· 5h', 'The bar gets properly cold once it fills up, bring a jacket!!!', '♥ 11 · Reply', 545],
  [703, 627, IMG.shermanZhuo, 'Mei Xuan', 806, '· 1d', 'Is there a cloakroom? Last time the queue for bags was longer than the one for the bar.', '♥ 3 · Reply', 619],
  [703, 697, IMG.fallingArt, 'Ravi S.', 789, '· 1d', 'Caught their performance before, the low end down there was unreal. Going again for this.', '♥ 8 · Reply', 619],
];
---
<NavBar active="events" />

<!-- hero -->
<div class="absolute left-0 top-[72px] h-[240px] w-[1440px] overflow-hidden rounded-[4px]"><img src={IMG.eventHero} alt="" class="size-full object-cover" /></div>
<a href={ROUTES.eventsMap} class="absolute left-[48px] top-[96px] block h-[38px] w-[145px] rounded-[5px] bg-white">
  <img src="/assets/icons/arrow-left-black.svg" alt="" width="16" height="16" class="absolute left-[10px] top-[11px]" />
  <span class="absolute left-[34px] top-[10px] whitespace-nowrap font-geist text-[14px] leading-normal font-semibold text-black">Back to Events</span>
</a>
<span class="absolute left-[48px] top-[175px] block h-[28px] w-[147px] rounded-[6px] bg-[#747480]/8"><span class={`absolute left-[12px] top-[6px] whitespace-nowrap font-geist text-[12px] leading-normal font-bold ${tab === 'details' ? 'text-[#ededed]' : 'text-white'}`}>SAT 19 SEP · 8:00 PM</span></span>
<span class="absolute left-[203px] top-[175px] block h-[28px] w-[100px] rounded-[6px] bg-[#1e1e22]"><span class="absolute left-[12px] top-[6px] whitespace-nowrap font-geist text-[12px] leading-normal font-bold text-white">ELECTRONIC</span></span>
<h1 class={`absolute left-[48px] top-[219px] m-0 whitespace-nowrap font-outfit text-[36px] leading-normal font-extrabold ${tab === 'details' ? 'text-white' : 'text-[#ebffee]'}`}>FallingIslands @ BattleBox Fort Canning</h1>
<a href={ROUTES.thanks} class="absolute left-[946px] top-[216px] block h-[48px] w-[164px] rounded-[24px] bg-[#007aff]">
  <span class="absolute left-[32px] top-[15px] whitespace-pre text-[15px] leading-normal font-semibold text-white">{'Get tickets  ↗'}</span>
</a>
<button type="button" class="absolute left-[1122px] top-[216px] block h-[48px] w-[147px] rounded-[8px] bg-[rgba(120,120,128,0.16)]">
  <img src="/assets/icons/heart-black.svg" alt="" width="16" height="16" class="absolute left-[24px] top-[16px]" />
  <span class="absolute left-[48px] top-[15px] whitespace-nowrap font-geist text-[14px] leading-normal font-semibold text-black">Save event</span>
</button>
<button type="button" class="absolute left-[1281px] top-[216px] block h-[48px] w-[111px] rounded-[8px] border border-[#27272a]">
  <img src="/assets/icons/share-black.svg" alt="" width="16" height="16" class="absolute left-[23px] top-[15px]" />
  <span class="absolute left-[47px] top-[14px] whitespace-pre font-geist text-[14px] leading-normal font-semibold text-black">Share </span>
</button>

<!-- about + line-up -->
<h2 class="absolute left-[80px] top-[336px] m-0 font-dm text-[16px] leading-normal font-bold text-[#111827]">About this event</h2>
<p class="absolute left-[80px] top-[369px] m-0 w-[1280px] font-dm text-[14px] leading-[1.5] text-[#545454]">FallingIslands bring the full analogue synth rig down into the BattleBox bunker for a late-night synthwave bill, with Lullaboy, Kin Leonn and Riot !n Magenta in support. They are playing the new EP end to end, plus two tracks that are not out yet.</p>
<h2 class="absolute left-[80px] top-[423px] m-0 font-outfit text-[16px] leading-normal font-bold text-black">Line-up</h2>
<a href={ROUTES.artist} class="absolute left-[80px] top-[459px] block h-[44px] w-[145px]">
  <img src={IMG.fallingIslandsSq} alt="" width="44" height="44" class="absolute left-0 top-0 size-[44px] rounded-[22px] border border-[#27272a] object-cover" />
  <span class="absolute left-[54px] top-[13.5px] whitespace-nowrap text-[14px] leading-normal font-medium text-[#1a1a1a]">FallingIslands</span>
</a>

<!-- tabs -->
<a href={ROUTES.event} class={`absolute left-[80px] top-[523px] block h-[41px] font-dm text-[16px] leading-normal ${tab === 'details' ? 'w-[55px] border-b border-[#111827] font-bold text-[#111827]' : 'w-[52px] font-medium text-[#4b5563]'}`}><span class="absolute left-0 top-[10px]">Details</span></a>
<a href={ROUTES.eventForum} class={`absolute top-[523px] block h-[41px] font-dm text-[16px] leading-normal ${tab === 'forum' ? 'left-[156px] w-[94px] border-b border-[#111827] font-bold text-[#111827]' : 'left-[159px] w-[90px] font-medium text-[#4b5563]'}`}><span class="absolute left-0 top-[10px]">Discussions</span></a>
<div class="absolute left-[80px] top-[576px] h-px w-[1280px] bg-[#e5e7eb]"></div>

{tab === 'details' ? (
  <>
    <h3 class="absolute left-[80px] top-[596px] m-0 font-dm text-[16px] leading-normal font-bold text-[#111827]">Event details</h3>
    {SPECS.map(([x, y, l, v, c]) => (
      <>
        <p class={label} style={`left:${x}px; top:${y}px`}>{l}</p>
        <p class={val} style={`left:${x}px; top:${y + 18}px; color:${c}`}>{v}</p>
      </>
    ))}
    <h3 class="absolute left-[880px] top-[596px] m-0 font-dm text-[16px] leading-normal font-bold text-[#111827]">Who's going</h3>
    <p class="absolute left-[880px] top-[629px] m-0 font-dm text-[26px] leading-normal font-bold text-[#111827]">118</p>
    <p class="absolute left-[880px] top-[665px] m-0 text-[12px] leading-normal text-[#747480]">going</p>
    <p class="absolute left-[955px] top-[629px] m-0 font-dm text-[26px] leading-normal font-bold text-[#111827]">3</p>
    <p class="absolute left-[955px] top-[665px] m-0 whitespace-nowrap text-[12px] leading-normal text-[#747480]">friends from Spotify</p>
    {[IMG.goingA, IMG.shermanZhuo, IMG.fallingIslandsSq, IMG.goingB, IMG.rosaPark].map((src, i) => (
      <img src={src} alt="" width="26" height="26" class="absolute top-[692px] size-[26px] rounded-full border-2 border-white object-cover" style={`left:${880 + i * 18}px`} />
    ))}
    <p class="absolute left-[988px] top-[696px] m-0 w-[372px] text-[13px] leading-[1.4] text-[#4b5563]">Rosa Park, Joel Tan and Mei Xuan are going</p>
    <div class="absolute left-[880px] top-[730px] h-px w-[480px] bg-[#e4e4e7]"></div>
    <p class="absolute left-[880px] top-[743px] m-0 whitespace-nowrap text-[11px] leading-normal font-medium text-[#757575]">MORE AT BATTLEBOX FORT CANNING</p>
    {[['Thu 24 Sep', 'Late Transmission'], ['Sat 03 Oct', 'Lullaboy live'], ['Fri 09 Oct', 'INTRGNT']].map(([d, t], i) => (
      <>
        <p class="absolute left-[880px] m-0 w-[78px] text-[12px] leading-normal font-medium text-[#747480]" style={`top:${768.5 + i * 24}px`}>{d}</p>
        <p class="absolute left-[972px] m-0 w-[388px] text-[13px] leading-normal text-[#111827]" style={`top:${768 + i * 24}px`}>{t}</p>
      </>
    ))}
    <a href={ROUTES.eventsList} class="absolute left-[880px] top-[844px] w-[480px] text-[14px] leading-[1.4] text-black underline">See all events at BattleBox at Fort Canning</a>
  </>
) : (
  <>
    <h3 class="absolute left-[80px] top-[596px] m-0 font-dm text-[16px] leading-normal font-bold text-[#181818]">Discussions</h3>
    <p class="absolute left-[1284px] top-[599px] m-0 whitespace-nowrap text-[12px] leading-normal text-[#747480]">12 comments</p>
    {COMMENTS.map(([x, y, av, name, metaX, time, body, foot, w]) => (
      <>
        <img src={av} alt="" width="28" height="28" class="absolute size-[28px] rounded-full border border-[#27272a] object-cover" style={`left:${x}px; top:${y}px`} />
        <p class="absolute m-0 whitespace-nowrap text-[13px] leading-normal font-semibold text-[#111827]" style={`left:${x + 38}px; top:${y}px`}>{name}</p>
        <p class="absolute m-0 whitespace-nowrap text-[12px] leading-normal text-[#747480]" style={`left:${metaX}px; top:${y + 0.5}px`}>{time}</p>
        <p class="absolute m-0 text-[13px] leading-[1.45]" style={`left:${x + 38}px; top:${y + 19}px; width:${w}px; color:${x === 80 ? '#545454' : '#4b5563'}`}>{body}</p>
        <p class="absolute m-0 whitespace-nowrap text-[12px] leading-normal text-[#747480]" style={`left:${x + 38}px; top:${y + 41}px`}>{foot}</p>
      </>
    ))}
    <a href={ROUTES.thread} class="absolute left-[80px] top-[763px] w-[1280px] text-[14px] leading-normal text-[#0088ff]">Open the full thread in Forum  →</a>
  </>
)}
