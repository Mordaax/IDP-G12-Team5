---
// Figma: "map-canvas" (988 × 640) with genre key and zoom; pins, labels and tray come from props.
import { IMG } from '../../data/images';
interface Props { src: string }
const { src } = Astro.props;
const KEY: [string, string][] = [['#4e6df5', 'Indie Rock'], ['#8b5cf6', 'Pop Music'], ['#ec6a9c', 'Contemporary Mandopop'], ['#0fb3a1', 'Electronic'], ['#f5a524', 'Hip-Hop'], ['#3fa96a', 'Traditional Ethnic Music']];
---
<div class="absolute left-[372px] top-[184px] h-[640px] w-[988px] overflow-hidden rounded-[12px] border border-[#ddd]">
  <img src={src} alt="Map" class="size-full object-cover" />
</div>
<div class="absolute left-[388px] top-[200px] h-[225px] w-[190px] rounded-[10px] border border-[#ddd] bg-white">
  <p class="absolute left-[13px] top-[13px] m-0 text-[10px] leading-normal font-semibold text-[#888]">GENRE KEY</p>
  {KEY.map(([c, t], i) => (
    <>
      <span class="absolute left-[13px] size-[8px] rounded-full" style={`top:${40 + i * 24}px; background:${c}`}></span>
      <span class="absolute left-[29px] whitespace-nowrap text-[12px] leading-normal text-[#1a1a1a]" style={`top:${37 + i * 24}px`}>{t}</span>
    </>
  ))}
  <div class="absolute left-[13px] top-[183px] h-px w-[162px] bg-[#eee]"></div>
  <span class="absolute left-[12px] top-[198px] size-[10px] rounded-full border-2 border-white bg-[#1a73e8] box-content -m-[2px]"></span>
  <span class="absolute left-[29px] top-[195px] whitespace-nowrap text-[12px] leading-normal text-[#1a1a1a]">Your location</span>
</div>
<div class="absolute left-[1300px] top-[200px] h-[80px] w-[40px] rounded-[8px] border border-[#ddd] bg-white">
  <button type="button" aria-label="Zoom in" class="absolute left-[14px] top-[7px] text-[16px] leading-normal text-[#1a1a1a]">+</button>
  <div class="absolute left-[-1px] top-[39px] h-px w-[40px] bg-[#eee]"></div>
  <button type="button" aria-label="Zoom out" class="absolute left-[14px] top-[47px] text-[16px] leading-normal text-[#1a1a1a]">−</button>
</div>
<slot />
