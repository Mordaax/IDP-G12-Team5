---
// Figma: "filter-panel" (260 × 710) on the Events screens.
// Checkbox states: 'on' (red, ticked) · 'red' (red outline) · 'off' (grey outline).
import { GENRES } from '../../data/genres';
type Box = 'on' | 'red' | 'off';
interface Artist { name: string; avatar: string; count: string; box: Box; nameX?: number; countX?: number }
interface Props {
  search?: string;
  searchHref?: string;
  prefOn?: boolean;
  genres: Box[];                        // in GENRES order
  artists: Artist[];
  applyHref?: string;
}
const { search, searchHref, prefOn = true, genres, artists, applyHref } = Astro.props;
const COUNTS = [['27', 311], ['32', 310], ['18', 312], ['24', 310], ['21', 312], ['14', 311]] as const;
const box = (b: Box) => b === 'on' ? 'border-brand bg-brand' : b === 'red' ? 'border-brand' : 'border-[#aaa]';
const DATES: [string, string, number][] = [['Today', '16', 96], ['Thu', '17', 126], ['Fri', '18', 166.5], ['Sat', '19', 202.5], ['Sun', '20', 238.5], ['Mon', '21', 275.5], ['Tue', '22', 308]];
const label = 'absolute m-0 whitespace-nowrap text-[11px] leading-normal font-semibold text-[#888]';
const SearchTag = searchHref ? 'a' : 'label';
---
<div class="absolute left-[80px] top-[184px] h-[710px] w-[260px] rounded-[12px] border border-[#ddd] bg-white"></div>

<SearchTag href={searchHref} class="absolute left-[96px] top-[200px] block h-[44px] w-[228px] rounded-[100px] bg-[rgba(120,120,128,0.16)]">
  <svg class="absolute left-[11px] top-[13px]" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="7.5" cy="7.5" r="6" stroke="#727272" stroke-width="1.8"/><path d="M12 12L16.5 16.5" stroke="#727272" stroke-width="1.8" stroke-linecap="round"/></svg>
  <span class={`absolute left-[40px] top-[11px] font-sf text-[17px] leading-[22px] tracking-[-0.08px] ${search ? 'text-[#1a1a1a]' : 'text-[#727272]'}`}>{search ?? 'Search'}</span>
  <svg class="absolute left-[201px] top-[12px]" width="12" height="19" viewBox="0 0 12 19" fill="none" aria-hidden="true"><rect x="3" y="1" width="6" height="11" rx="3" fill="#727272"/><path d="M1 9C1 12 3.2 14 6 14C8.8 14 11 12 11 9M6 14V18" stroke="#727272" stroke-width="1.6" stroke-linecap="round"/></svg>
</SearchTag>

<div class="absolute left-[96px] top-[256px] h-px w-[228px] bg-[#eee]"></div>
<p class="absolute left-[96px] top-[270px] m-0 whitespace-pre text-[12px] leading-normal font-medium text-[#1a1a1a]">{'♥  Your Preferences'}</p>
<button type="button" role="switch" aria-checked={prefOn ? 'true' : 'false'} class="absolute left-[286px] top-[268px] block h-[22px] w-[38px] rounded-[11px] bg-brand">
  <span class={`absolute top-[2px] size-[18px] rounded-full bg-white ${prefOn ? 'left-[18px]' : 'left-[2.5px]'}`}></span>
</button>

<div class="absolute left-[96px] top-[306px] h-px w-[228px] bg-[#eee]"></div>
<p class={`${label} left-[96px] top-[320px]`}>GENRE</p>
{GENRES.map((g, i) => {
  const y = 341 + i * 30;
  return (
    <>
      <span class={`absolute left-[96px] size-[16px] rounded-[4px] border ${box(genres[i])}`} style={`top:${y + 1}px`}>
        {genres[i] === 'on' && <span class="absolute left-[2px] top-[1px] text-[11px] leading-normal font-medium text-white">✓</span>}
      </span>
      <p class="absolute left-[122px] m-0 whitespace-nowrap text-[12px] leading-normal text-[#1a1a1a]" style={`top:${y}px`}>{g.name}</p>
      <p class="absolute m-0 text-[11px] leading-normal text-[#999]" style={`top:${y}px; left:${COUNTS[i][1]}px`}>{COUNTS[i][0]}</p>
    </>
  );
})}

<div class="absolute left-[96px] top-[528px] h-px w-[228px] bg-[#eee]"></div>
<p class={`${label} left-[96px] top-[542px]`}>ARTISTS</p>
{artists.map((a, i) => {
  const y = 568 + i * 30;
  return (
    <>
      <span class={`absolute left-[96px] size-[16px] rounded-[4px] border ${box(a.box)}`} style={`top:${y}px`}>
        {a.box === 'on' && <span class="absolute left-[2px] top-[-1px] text-[11px] leading-normal font-semibold text-white">✓</span>}
      </span>
      <img src={a.avatar} alt="" width="20" height="20" class="absolute left-[122px] size-[20px] rounded-full object-cover" style={`top:${y - 2}px`} />
      <p class="absolute m-0 whitespace-nowrap text-[12px] leading-normal text-[#1a1a1a]" style={`top:${y}px; left:${a.nameX ?? 150}px`}>{a.name}</p>
      <p class="absolute m-0 text-[11px] leading-normal text-[#999]" style={`top:${y}px; left:${a.countX ?? 316}px`}>{a.count}</p>
    </>
  );
})}
<button type="button" class="absolute left-[96px] top-[628px] whitespace-nowrap text-[12px] leading-normal font-medium text-brand">+ Show more artists</button>

<div class="absolute left-[96px] top-[658px] h-px w-[228px] bg-[#eee]"></div>
<p class={`${label} left-[96px] top-[672px]`}>DISTANCE</p>
<p class="absolute left-[256px] top-[671px] m-0 whitespace-nowrap text-[11px] leading-normal font-medium text-[#1a1a1a]">Within 13 km</p>
<div class="absolute left-[96px] top-[698px] h-[4px] w-[228px] rounded-[2px] bg-[#ddd]"></div>
<div class="absolute left-[96px] top-[698px] h-[4px] w-[148px] rounded-[2px] bg-[#888]"></div>
{[[96, '0', 96], [153, '5', 150], [210, '10', 205], [267, '15', 262], [323, '20+ km', 291]].map(([tx, t, lx]) => (
  <>
    <span class="absolute top-[706px] h-[5px] w-px bg-[#ddd]" style={`left:${tx}px`}></span>
    <span class="absolute top-[714px] whitespace-nowrap text-[9px] leading-normal text-[#999]" style={`left:${lx}px`}>{t}</span>
  </>
))}
<span class="absolute left-[234px] top-[690px] size-[20px] rounded-full border border-[#aaa] bg-white"></span>

<div class="absolute left-[96px] top-[738px] h-px w-[228px] bg-[#eee]"></div>
<p class={`${label} left-[96px] top-[752px]`}>DATE</p>
<p class="absolute left-[244px] top-[751px] m-0 whitespace-nowrap text-[11px] leading-normal font-medium text-[#1a1a1a]">Today – Tue 22</p>
<div class="absolute left-[96px] top-[778px] h-[4px] w-[228px] rounded-[2px] bg-[#888]"></div>
{[96, 134, 172, 210, 247, 285, 323].map((tx) => <span class="absolute top-[786px] h-[5px] w-px bg-[#ddd]" style={`left:${tx}px`}></span>)}
{DATES.map(([d, n, x]) => <span class="absolute top-[794px] text-center text-[9px] leading-normal text-[#999]" style={`left:${x}px`}>{d}<br />{n}</span>)}
<span class="absolute left-[304px] top-[770px] size-[20px] rounded-full border border-[#aaa] bg-white"></span>

<a href={applyHref} class="absolute left-[96px] top-[828px] block h-[50px] w-[228px] rounded-[25px] bg-[#007aff]">
  <span class="absolute left-[72px] top-[15px] whitespace-nowrap text-[15px] leading-normal font-semibold text-white">Apply filters</span>
</a>
