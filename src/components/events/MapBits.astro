---
// Pins, pin labels, "you are here" and tray cards on the Events map (positions are page coordinates).
interface Pin { x: number; y: number; color: string }
interface Label { x: number; y: number; w: number; text: string; href?: string; icon?: boolean }
interface Tray { x: number; date: string; thumb: string; name: string; venue: string; price: string; going: string; href?: string }
interface Props { pins?: Pin[]; labels?: Label[]; trays?: Tray[]; youAreHere?: boolean }
const { pins = [], labels = [], trays = [], youAreHere = false } = Astro.props;
---
{youAreHere && (
  <>
    <span class="absolute left-[692px] top-[539px] size-[72px] rounded-full border-[1.5px] border-[#1a73e8] bg-[#1a73e8]/20"></span>
    <span class="absolute left-[717px] top-[564px] size-[22px] rounded-full border-[3px] border-white bg-[#1a73e8] shadow-[0px_2px_6px_0px_rgba(0,0,0,0.3)]"></span>
  </>
)}
{pins.map((p) => (
  <svg class="absolute overflow-visible" style={`left:${p.x}px; top:${p.y}px`} width="13" height="13" aria-hidden="true"><circle cx="6.5" cy="6.5" r="6.5" fill={p.color} stroke="white" stroke-width="4" paint-order="stroke" /></svg>
))}
{labels.map((l) => {
  const Tag = l.href ? 'a' : 'div';
  return (
    <Tag href={l.href} class="absolute block h-[27px] rounded-[15px] border border-[#ddd] bg-white/78" style={`left:${l.x}px; top:${l.y}px; width:${l.w}px`}>
      <span class="absolute left-[7px] top-[6px] whitespace-nowrap text-[12px] leading-normal text-[#1a1a1a]">{l.text}</span>
      {l.icon && <svg class="absolute left-[110px] top-[4px]" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="7.6" cy="7.6" r="5.6" stroke="#727272" stroke-width="2"/><path d="M11.8 11.8L15.5 15.5" stroke="#727272" stroke-width="2" stroke-linecap="round"/></svg>}
    </Tag>
  );
})}
{trays.map((t) => {
  const Tag = t.href ? 'a' : 'div';
  return (
    <Tag href={t.href} class="absolute top-[696px] block h-[112px] w-[300px] rounded-[10px] border border-[#ddd] bg-white" style={`left:${t.x}px`}>
      <span class="absolute left-[15px] top-[13px] whitespace-nowrap text-[10px] leading-normal font-semibold text-[#888]">{t.date}</span>
      <img src={t.thumb} alt="" width="40" height="40" class="absolute left-[15px] top-[37px] size-[40px] rounded-full object-cover" />
      <span class="absolute left-[67px] top-[39px] whitespace-nowrap text-[14px] leading-normal font-semibold text-[#1a1a1a]">{t.name}</span>
      <span class="absolute left-[67px] top-[59px] whitespace-nowrap text-[12px] leading-normal text-[#666]">{t.venue}</span>
      <span class="absolute left-[231px] top-[9px] block h-[24px] w-[52px] rounded-[12px] border border-[#ddd]"><span class="absolute left-[13px] top-[3px] text-[12px] leading-normal text-[#666]">{t.price}</span></span>
      <span class="absolute left-[67px] top-[79px] whitespace-nowrap text-[10px] leading-normal text-[#888]">{t.going}</span>
    </Tag>
  );
})}
