---
// 📸 13 Events (Map) Filtered — Figma 1431:3394 (from fixed screen [2-13]).
import Screen from '../../layouts/Screen.astro';
import NavBar from '../../components/NavBar.astro';
import EventsHeader from '../../components/events/EventsHeader.astro';
import FilterPanel from '../../components/events/FilterPanel.astro';
import MapCanvas from '../../components/events/MapCanvas.astro';
import MapBits from '../../components/events/MapBits.astro';
import { IMG } from '../../data/images';
import { ROUTES } from '../../data/routes';
---
<Screen title="Events · Map">
  <NavBar active="events" />
  <EventsHeader view="map" subtitle="3 events featuring FallingIslands" />
  <FilterPanel searchHref={ROUTES.eventsMapSearch} prefOn applyHref={ROUTES.eventsList}
    genres={['off', 'red', 'off', 'off', 'red', 'off']}
    artists={[
      { name: 'FallingIslands', avatar: IMG.fallingIslandsSq, count: '3', box: 'on' },
      { name: 'Evanturetime', avatar: IMG.evanturetime, count: '1', box: 'red', countX: 317 },
    ]} />
  <MapCanvas src={IMG.eventsMap}>
    <MapBits youAreHere
      pins={[{ x: 760, y: 486, color: '#0fb3a1' }, { x: 642, y: 523, color: '#0fb3a1' }, { x: 1222, y: 375, color: '#0fb3a1' }]}
      labels={[
        { x: 569, y: 548, w: 157, text: 'FallingIslands · Sat 8PM', href: ROUTES.event },
        { x: 1143, y: 400, w: 157, text: 'FallingIslands · Tue 8PM', href: ROUTES.event },
        { x: 688, y: 506, w: 157, text: 'FallingIslands ·Sat 9pm', href: ROUTES.event },
      ]}
      trays={[
        { x: 388, date: 'WED 16 SEP · 9PM', thumb: IMG.fallingIslandsSq, name: 'FallingIslands', venue: 'TinBox @ Bras Basah · 0.4km', price: '$25', going: '118 going · 3 friends', href: ROUTES.event },
        { x: 708, date: 'SAT 19 SEP · 8PM', thumb: IMG.fallingIslandsSq, name: 'FallingIslands', venue: 'Battlebox @ Fort Canning · 0.4km', price: '$32', going: '76 going · 2 friends', href: ROUTES.event },
        { x: 1028, date: 'TUE 22 SEP · 7:30PM', thumb: IMG.fallingIslandsSq, name: 'FallingIslands', venue: 'Kilo Lounge · 2.4km', price: '$20', going: '54 going · 1 friend', href: ROUTES.event },
      ]} />
  </MapCanvas>
</Screen>
