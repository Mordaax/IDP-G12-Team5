---
// Onboarding (your taste profile — manual) — Figma 1439:278.
import Screen from '../../layouts/Screen.astro';
import OnboardingHeader from '../../components/onboarding/OnboardingHeader.astro';
import GenreCard from '../../components/onboarding/GenreCard.astro';
import SongCard from '../../components/onboarding/SongCard.astro';
import { ROUTES } from '../../data/routes';
---
<Screen title="Your taste profile">
  <OnboardingHeader title="Your taste profile" subtitle="Choose the genres and songs that feel most like you. You can change these any time." />

  <GenreCard x={190} y={204} title="Your genres" chipStyle="bold"
    selected={['Indie Rock', 'Electronic', 'Synthwave']}
    dotOverrides={{ Electronic: '#1f1f1f' }}
    summary="3 genres selected" />
  <SongCard x={730} y={204} title="Your songs" added={[false, false, false]} addLeft={[15, 15, 17]} />

  <div class="absolute left-[190px] top-[565px] h-[72px] w-[1060px] overflow-clip rounded-[12px] border border-[#ddd] bg-[#f7f7f7]">
    <p class="absolute left-[23px] top-[15px] m-0 whitespace-nowrap text-[10px] leading-normal font-semibold text-[#888]">YOUR TASTE PROFILE</p>
    <p class="absolute left-[23px] top-[37px] m-0 whitespace-nowrap text-[12px] leading-normal text-[#666]">Updates as you pick. You can change it any time.</p>
    <p class="absolute left-[415px] top-[25px] m-0 w-[620px] whitespace-pre text-[13px] leading-normal text-[#888]">{'Indie Rock · Electronic · Synthwave   •   Tracks of the Woods · Slow Burn'}</p>
  </div>

  <a href={ROUTES.onboarding} class="absolute left-[476px] top-[664px] block h-[48px] w-[240px] rounded-[24px] bg-[#e1e1e1]">
    <span class="absolute left-[93px] top-[15px] whitespace-pre text-[15px] leading-normal font-semibold text-black">{'← Back  '}</span>
  </a>
  <a href={ROUTES.forYou} class="absolute left-[729px] top-[664px] block h-[48px] w-[240px] rounded-[24px] bg-[#007aff]">
    <span class="absolute left-[66px] top-[15px] whitespace-pre text-[15px] leading-normal font-semibold text-white">{'Save profile  →'}</span>
  </a>
</Screen>
