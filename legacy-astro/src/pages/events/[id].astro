---
// Every /events/* URL renders the same Vue app; its router picks the screen (map, list or event detail).
import EventsApp from '../../layouts/EventsApp.astro';
import EventsRoot from '../../events-app/EventsApp.vue';
import { events } from '../../events-app/features/events/data/mockData.js';

export function getStaticPaths() {
  const ids = ['map', 'list', 'battlebox', ...events.map((e) => e.id)];
  return ids.map((id) => ({ params: { id } }));
}
---
<EventsApp title="Events">
  <div id="events-root"><EventsRoot client:only="vue" /></div>
</EventsApp>
