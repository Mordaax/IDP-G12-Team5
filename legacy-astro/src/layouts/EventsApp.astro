---
// Plain responsive shell for the Vue + Bootstrap Events app (the other screens use the fixed 1440px Screen layout).
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/assets/img/brand.png" />
    <title>{title} · LittleRedMusic</title>
  </head>
  <body>
    <slot />
  </body>
</html>
