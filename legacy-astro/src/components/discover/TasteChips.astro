---
// Figma: taste-profile chips under the graph (📸 7–9).
const CHIPS = [
  { x: 372,   w: 200, dot: '#0fb3a1', text: '78% Electronic Dance Music' },
  { x: 582.4, w: 104, dot: '#8b5cf6', text: '67% Alt-pop' },
  { x: 697,   w: 207, dot: '#ec6a9c', text: '35% Contemporary Mandopop' },
];
---
{CHIPS.map((c) => (
  <div class="absolute top-[700px] h-[30px] rounded-[15px] bg-white ring-1 ring-inset ring-line" style={`left:${c.x}px; width:${c.w}px`}>
    <span class="absolute left-[12px] top-[11px] size-[8px] rounded-full" style={`background:${c.dot}`}></span>
    <span class="absolute left-[26px] top-[7px] whitespace-nowrap text-[12px] leading-normal text-[#1a1a1a]">{c.text}</span>
  </div>
))}
