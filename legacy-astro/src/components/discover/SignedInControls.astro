---
// Figma: "Graph controls" on the signed-in Discover screens (📸 7–9) — web search, genre chips, stats.
import { GENRES } from '../../data/genres';
const CHIPS: [number, number, number, number][] = [ // genre index → x, y, width (relative to map area)
  [0, 133, 78, 106], [1, 247, 78, 106], [2, 36, 119, 194], [3, 238, 119, 104], [4, 350, 119, 95], [5, 36, 160, 184],
];
---
<label class="absolute left-[36px] top-[24px] block h-[42px] w-[300px] rounded-[999px] bg-white shadow-[0px_2px_10px_0px_rgba(0,0,0,0.3)] ring-1 ring-inset ring-line">
  <span class="absolute left-[16px] top-[14px] size-[14px] rounded-full bg-[#5c5c5c]"></span>
  <input type="search" placeholder="Search the web…" class="absolute left-[40px] top-[12px] w-[240px] bg-transparent p-0 text-[13px] leading-[1.4] text-ink outline-none placeholder:text-[#5c5c5c]" />
</label>
<button type="button" class="absolute left-[36px] top-[78px] block h-[33px] w-[89px] rounded-[999px] border-[1.6px] border-[#1a1a1a] bg-[#1a1a1a]">
  <span class="absolute left-[13.4px] top-[6.4px] whitespace-nowrap text-[12px] leading-[1.4] font-semibold text-white">All genres</span>
</button>
{CHIPS.map(([i, x, y, w]) => (
  <button type="button" class="absolute block h-[33px] rounded-[999px] bg-white ring-1 ring-inset ring-line" style={`left:${x}px; top:${y}px; width:${w}px`}>
    <span class="absolute left-[15px] top-[12px] size-[9px] rounded-full" style={`background:${GENRES[i].dot}`}></span>
    <span class="absolute left-[31px] top-[8px] whitespace-nowrap text-[12px] leading-[1.4] font-medium text-black">{GENRES[i].name}</span>
  </button>
))}
<div class="absolute left-[36px] top-[205px] h-[35px] w-[263px] rounded-[12px] bg-white ring-1 ring-inset ring-line">
  <span class="absolute left-[14px] top-[13px] size-[9px] rounded-full bg-[#a98be0]"></span>
  <span class="absolute left-[31px] top-[9px] whitespace-nowrap text-[12px] leading-[1.4] text-[#5c5c5c]">178 artists · 412 shared-audience links</span>
</div>
