---
// Signed-out Discover map body (everything below the nav on 📸 1).
// Reused, blurred, behind the sign-up modal on 📸 3 and 📸 4.
import WebGraph from './WebGraph.astro';
import GraphControls from './GraphControls.astro';
import Legend from './Legend.astro';
import MapButtons from './MapButtons.astro';
import WelcomeGuide from './WelcomeGuide.astro';
---
<section class="absolute left-0 top-[72px] h-[828px] w-[1440px] overflow-clip bg-white" aria-label="Web of artists">
  <WebGraph />
  <GraphControls />
  <Legend />
  <MapButtons />
  <WelcomeGuide />
</section>
<img src="/assets/img/avatar-pop.png" alt="" width="26" height="26" class="absolute left-[523px] top-[606px] size-[26px] max-w-none" />
