---
// Figma: "Legend" card (bottom-left of the map).
import { GENRES } from '../../data/genres';
---
<section class="absolute left-[36px] top-[585px] flex w-[300px] flex-col items-start gap-[8px] overflow-clip rounded-[16px] ring-1 ring-inset ring-line bg-white p-[16px] shadow-[0px_2px_12px_0px_rgba(0,0,0,0.3)]">
  <div class="flex w-full items-center gap-[8px]">
    <img src="/assets/icons/legend.svg" alt="" width="18" height="18" class="size-[18px] shrink-0" />
    <h2 class="m-0 min-w-px flex-1 text-[13px] leading-[1.4] font-semibold text-ink">Legend</h2>
    <span class="relative h-[4.5px] w-[9px] shrink-0">
      <img src="/assets/icons/chevron-up.svg" alt="" width="11" height="6" class="absolute left-[-0.7px] top-[-0.7px] max-w-none" />
    </span>
  </div>
  <div class="h-px w-[268px] shrink-0 bg-divider"></div>
  <p class="m-0 whitespace-nowrap text-[11px] leading-[1.4] font-bold tracking-[0.66px] text-muted">DOT COLOUR = GENRE</p>
  <div class="flex w-full flex-wrap content-start items-start gap-x-[8px] gap-y-[7px]">
    {GENRES.map((g) => (
      <div class="flex w-[130px] shrink-0 items-center gap-[7px] overflow-clip">
        <span class="size-[9px] shrink-0 rounded-full" style={`background:${g.dot}`}></span>
        <p class="m-0 min-w-px flex-1 text-[10px] leading-[1.4] text-ink-2">{g.name}</p>
      </div>
    ))}
  </div>
  <div class="h-px w-full shrink-0 bg-divider"></div>
  <div class="flex w-full items-center gap-[9px] overflow-clip">
    <span class="size-[10px] shrink-0 rounded-full bg-[#9c9a98]"></span>
    <p class="m-0 whitespace-nowrap text-[12px] leading-[1.4] text-ink-2">Bigger dot = more fans</p>
  </div>
  <div class="flex w-full items-center gap-[9px] overflow-clip">
    <span class="h-[2px] w-[18px] shrink-0 rounded-[99px] bg-[#4e4a57]"></span>
    <p class="m-0 whitespace-nowrap text-[12px] leading-[1.4] text-ink-2">Line = shared audience</p>
  </div>
</section>
